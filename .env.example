# Copy to .env and adapt before starting
DOMAIN=example.com
HOSTNAME_FQDN=relay.example.com
DKIM_SELECTOR=mail
# CIDRs of SMTP clients allowed to relay. Never use 0.0.0.0/0.
# Docker bridge client IPs must be explicitly added.
MYNETWORKS=127.0.0.0/8
# Empty = direct MX delivery; e.g. [smtp.example.net]:587
RELAYHOST=
# may is recommended for direct MX delivery
SMTP_TLS_SECURITY_LEVEL=may
